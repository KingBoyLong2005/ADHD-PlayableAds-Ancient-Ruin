// Ported from Unity URP ShaderGraph: _DangerDungeon/Shaders/Lit_Enemy_Basic.shadergraph
// Graph logic:
//   tex        = SampleTexture2D(_Base_Map, uv0)
//   tintMask   = lerp(1, tex.a, _Use_Alpha_Mask)
//   tinted     = tex * ColorSwitch(_Color_ID, None/Green/Blue/Yellow/Orange/Red)
//   base       = lerp(tex, tinted, tintMask)
//   final      = lerp(base, base * hitColor, _get_hit)
//   BaseColor  = final ; Emission = final * _Light_Strength
//   Smoothness = _smoothness ; Metallic = 0 ; Occlusion = 1
//
// Palette dùng cặp "color picker + intensity" giống HDR color của Unity:
//   giá trị thật = SRGBToLinear(color) * intensity
// (color khai báo `linear: true` nên runtime tự chuyển sRGB -> linear như Unity)
CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: standard-vs
      frag: standard-fs
      properties: &props
        tilingOffset:    { value: [1.0, 1.0, 0.0, 0.0] }
        mainTexture:     { value: grey, editor: { displayName: BaseMap } }
        colorId:         { value: 0.0, target: params.x, editor: { displayName: Color ID (0-5), slide: true, range: [0, 5], step: 1 } }
        getHit:          { value: 0.0, target: params.y, editor: { displayName: Get Hit, slide: true, range: [0, 1], step: 0.001 } }
        lightStrength:   { value: 0.3, target: params.z, editor: { displayName: Light Strength, slide: true, range: [0, 4], step: 0.001 } }
        smoothness:      { value: 0.25, target: params.w, editor: { slide: true, range: [0, 1], step: 0.001 } }
        useAlphaMask:    { value: 1.0, target: params2.x, editor: { displayName: Use Alpha Mask, slide: true, range: [0, 1], step: 1 } }

        colorNone:       { value: [1.0, 1.0, 1.0, 1.0], linear: true, editor: { displayName: None, type: color } }
        noneIntensity:   { value: 1.0, target: intensity1.x, editor: { displayName: None Intensity, slide: true, range: [0, 10], step: 0.001 } }
        colorGreen:      { value: [0.727147, 1.0, 0.0, 1.0], linear: true, editor: { displayName: Green, type: color } }
        greenIntensity:  { value: 1.361853, target: intensity1.y, editor: { displayName: Green Intensity, slide: true, range: [0, 10], step: 0.001 } }
        colorBlue:       { value: [0.125326, 0.899235, 1.0, 1.0], linear: true, editor: { displayName: Blue, type: color } }
        blueIntensity:   { value: 1.629706, target: intensity1.z, editor: { displayName: Blue Intensity, slide: true, range: [0, 10], step: 0.001 } }
        colorYellow:     { value: [1.0, 0.702605, 0.206041, 1.0], linear: true, editor: { displayName: Yellow, type: color } }
        yellowIntensity: { value: 3.169811, target: intensity1.w, editor: { displayName: Yellow Intensity, slide: true, range: [0, 10], step: 0.001 } }
        colorOrange:     { value: [1.0, 0.385711, 0.0, 1.0], linear: true, editor: { displayName: Orange, type: color } }
        orangeIntensity: { value: 3.396226, target: intensity2.x, editor: { displayName: Orange Intensity, slide: true, range: [0, 10], step: 0.001 } }
        colorRed:        { value: [1.0, 0.386026, 0.319374, 1.0], linear: true, editor: { displayName: Red, type: color } }
        redIntensity:    { value: 2.146254, target: intensity2.y, editor: { displayName: Red Intensity, slide: true, range: [0, 10], step: 0.001 } }

        hitColor:        { value: [1.0, 0.0, 0.0, 1.0], linear: true, editor: { displayName: Hit Color, type: color } }
        hitIntensity:    { value: 2.996078, target: intensity2.z, editor: { displayName: Hit Intensity, slide: true, range: [0, 10], step: 0.001 } }
    - &shadow-caster
      vert: shadow-caster-vs
      frag: shadow-caster-fs
      phase: shadow-caster
      propertyIndex: 0
      rasterizerState:
        cullMode: front
}%

CCProgram shared-ubos %{
  uniform Constants {
    vec4 tilingOffset;
    vec4 params;      // x: colorId, y: getHit, z: lightStrength, w: smoothness
    vec4 params2;     // x: useAlphaMask
    vec4 intensity1;  // x: none, y: green, z: blue, w: yellow
    vec4 intensity2;  // x: orange, y: red, z: hit
    vec4 hitColor;
    vec4 colorNone;
    vec4 colorGreen;
    vec4 colorBlue;
    vec4 colorYellow;
    vec4 colorOrange;
    vec4 colorRed;
  };
}%

CCProgram macro-remapping %{
  #pragma define-meta USE_TWOSIDE
  #define CC_SURFACES_USE_TWO_SIDED USE_TWOSIDE
}%

CCProgram surface-vertex %{
  #define CC_SURFACES_VERTEX_MODIFY_UV
  void SurfacesVertexModifyUV(inout SurfacesStandardVertexIntermediate In)
  {
    In.texCoord = In.texCoord * tilingOffset.xy + tilingOffset.zw;
  }
}%

CCProgram surface-fragment %{
  uniform sampler2D mainTexture;

  // Unity CustomFunction "ColorSwitch": OutColor = colorArray[index]
  // (color đã ở linear space nhờ `linear: true`, nhân thêm intensity để ra giá trị HDR như Unity)
  vec3 ColorSwitch6(float index)
  {
    int i = int(index + 0.5);
    vec3 o = colorNone.rgb * intensity1.x;
    if (i == 1) { o = colorGreen.rgb * intensity1.y; }
    else if (i == 2) { o = colorBlue.rgb * intensity1.z; }
    else if (i == 3) { o = colorYellow.rgb * intensity1.w; }
    else if (i == 4) { o = colorOrange.rgb * intensity2.x; }
    else if (i >= 5) { o = colorRed.rgb * intensity2.y; }
    return o;
  }

  vec3 EvaluateFinalColor()
  {
    vec4 tex = texture(mainTexture, FSInput_texcoord);
    tex.rgb = SRGBToLinear(tex.rgb);

    float tintMask = mix(1.0, tex.a, params2.x);
    vec3 base = mix(tex.rgb, tex.rgb * ColorSwitch6(params.x), tintMask);

    return mix(base, base * hitColor.rgb * intensity2.z, params.y);
  }

  #define CC_SURFACES_FRAGMENT_MODIFY_BASECOLOR_AND_TRANSPARENCY
  vec4 SurfacesFragmentModifyBaseColorAndTransparency()
  {
    return vec4(EvaluateFinalColor(), 1.0);
  }

  #define CC_SURFACES_FRAGMENT_MODIFY_EMISSIVE
  vec3 SurfacesFragmentModifyEmissive()
  {
    return EvaluateFinalColor() * params.z;
  }

  #define CC_SURFACES_FRAGMENT_MODIFY_PBRPARAMS
  vec4 SurfacesFragmentModifyPBRParams()
  {
    // x: occlusion, y: roughness (Unity smoothness -> 1 - smoothness), z: metallic, w: specular intensity
    return vec4(1.0, clamp(1.0 - params.w, 0.02, 1.0), 0.0, 0.5);
  }
}%

CCProgram standard-vs %{
  precision highp float;
  #include <macro-remapping>
  #include <surfaces/effect-macros/common-macros>
  #include <surfaces/includes/common-vs>
  #include <shared-ubos>
  #include <surface-vertex>
  #include <surfaces/includes/standard-vs>
  #include <shading-entries/main-functions/render-to-scene/vs>
}%

CCProgram standard-fs %{
  precision highp float;
  #include <macro-remapping>
  #include <surfaces/effect-macros/common-macros>
  #include <surfaces/includes/common-fs>
  #include <shared-ubos>
  #include <surface-fragment>
  #include <lighting-models/includes/standard>
  #include <surfaces/includes/standard-fs>
  #include <shading-entries/main-functions/render-to-scene/fs>
}%

CCProgram shadow-caster-vs %{
  precision highp float;
  #include <macro-remapping>
  #include <surfaces/effect-macros/render-to-shadowmap>
  #include <surfaces/includes/common-vs>
  #include <shared-ubos>
  #include <surface-vertex>
  #include <shading-entries/main-functions/render-to-shadowmap/vs>
}%

CCProgram shadow-caster-fs %{
  precision highp float;
  #include <macro-remapping>
  #include <surfaces/effect-macros/render-to-shadowmap>
  #include <surfaces/includes/common-fs>
  #include <shared-ubos>
  #include <surface-fragment>
  #include <shading-entries/main-functions/render-to-shadowmap/fs>
}%
