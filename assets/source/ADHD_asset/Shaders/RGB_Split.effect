// Ported from Unity URP ShaderGraph: _DangerDungeon/Shaders/RGB_Split.shadergraph
// Graph logic:
//   VertexPosition = worldPos + _Vector3            (offset applied in world space)
//   noiseUV        = TilingAndOffset(uv0, (-0.11, 1), time * _speed)
//   noise          = GradientNoise(noiseUV, 7.47)
//   fresnel        = Fresnel(power = 1)
//   BaseColor      = _Color_1 * (fresnel * noise)
//   Alpha          = _streght * fresnel
CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: split-vs:vert
      frag: split-fs:frag
      rasterizerState: { cullMode: none }
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties: &props
        vertexOffset: { value: [0.0, 0.0, 0.0, 0.0], editor: { displayName: Vector3 (world offset) } }
        # HDR emissive color (Unity value 39.16, 0, 7.76)
        splitColor:   { value: [39.16357, 0.0, 7.760025, 0.0], editor: { displayName: Color } }
        speed:        { value: 1.0, target: params.x, editor: { slide: true, range: [0, 8], step: 0.001 } }
        strength:     { value: 0.0, target: params.y, editor: { displayName: Streght, slide: true, range: [0, 1], step: 0.001 } }
        noiseScale:   { value: 7.47, target: params.z, editor: { displayName: Noise Scale } }
        fresnelPower: { value: 1.0, target: params.w, editor: { displayName: Fresnel Power, slide: true, range: [0, 8], step: 0.001 } }
  - name: add
    passes:
    - vert: split-vs:vert
      frag: split-fs:frag
      rasterizerState: { cullMode: none }
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one
          blendSrcAlpha: src_alpha
          blendDstAlpha: one
      properties: *props
}%

CCProgram split-vs %{
  precision highp float;
  #include <legacy/input-standard>
  #include <builtin/uniforms/cc-global>
  #include <legacy/local-batch>
  #include <legacy/fog-vs>

  out vec2 v_uv;
  out vec3 v_worldPos;
  out vec3 v_worldNormal;

  uniform SplitVert {
    vec4 vertexOffset;
  };

  vec4 vert () {
    StandardVertInput In;
    CCVertInput(In);

    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    vec4 worldPos = matWorld * In.position;
    worldPos.xyz += vertexOffset.xyz;

    v_uv = a_texCoord;
    v_worldPos = worldPos.xyz;
    v_worldNormal = normalize((matWorldIT * vec4(In.normal, 0.0)).xyz);

    CC_TRANSFER_FOG(worldPos);
    return cc_matProj * cc_matView * worldPos;
  }
}%

CCProgram split-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <legacy/output-standard>
  #include <legacy/fog-fs>

  in vec2 v_uv;
  in vec3 v_worldPos;
  in vec3 v_worldNormal;

  uniform SplitFrag {
    vec4 splitColor;
    vec4 params;   // x: speed, y: strength, z: noiseScale, w: fresnelPower
  };

  // ---- Unity_GradientNoise ----
  vec2 GradientNoiseDir(vec2 p)
  {
    p = mod(p, 289.0);
    float x = mod((34.0 * p.x + 1.0) * p.x, 289.0) + p.y;
    x = mod((34.0 * x + 1.0) * x, 289.0);
    x = fract(x / 41.0) * 2.0 - 1.0;
    return normalize(vec2(x - floor(x + 0.5), abs(x) - 0.5));
  }
  float GradientNoise(vec2 p)
  {
    vec2 ip = floor(p);
    vec2 fp = fract(p);
    float d00 = dot(GradientNoiseDir(ip), fp);
    float d01 = dot(GradientNoiseDir(ip + vec2(0.0, 1.0)), fp - vec2(0.0, 1.0));
    float d10 = dot(GradientNoiseDir(ip + vec2(1.0, 0.0)), fp - vec2(1.0, 0.0));
    float d11 = dot(GradientNoiseDir(ip + vec2(1.0, 1.0)), fp - vec2(1.0, 1.0));
    fp = fp * fp * fp * (fp * (fp * 6.0 - 15.0) + 10.0);
    return mix(mix(d00, d01, fp.y), mix(d10, d11, fp.y), fp.x);
  }

  vec4 frag () {
    vec3 N = normalize(v_worldNormal);
    vec3 V = normalize(cc_cameraPos.xyz - v_worldPos);
    float fresnel = pow(max(1.0 - max(dot(N, V), 0.0), 0.0), max(params.w, 1e-4));

    vec2 noiseUV = v_uv * vec2(-0.11, 1.0) + cc_time.x * params.x;
    float noise = GradientNoise(noiseUV * params.z) + 0.5;

    vec4 o = splitColor * (fresnel * noise);
    o.a = params.y * fresnel;

    CC_APPLY_FOG(o);
    return CCFragOutput(o);
  }
}%
