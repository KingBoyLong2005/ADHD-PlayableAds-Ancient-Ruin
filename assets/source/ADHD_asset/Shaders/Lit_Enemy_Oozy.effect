// Ported from Unity URP ShaderGraph: _DangerDungeon/Shaders/Lit_Enemy_Oozy.shadergraph
// Graph logic:
//   uvN        = TilingAndOffset(uv0, tillingOffset.xy, tillingOffset.zw + time * 0.1)
//   refract    = SampleTexture2D(_Normal, uvN) * _refaction_amount
//   sceneColor = SceneColor(screenPos + refract)
//   tinted     = SampleTexture2D(_base_map, uv0) * _Tint
//   heightMask = smoothstep(0, 0.3, worldPos.y)
//   glow       = sceneColor * tinted * heightMask
//   BaseColor  = step(_step, Fresnel(_power)) + glow ; Emission = glow ; Smoothness = 0.17
//
// NOTE: Cocos has no built-in "Scene Color" (opaque grab) texture. Assign a RenderTexture
// captured by a second camera to `sceneColorMap`, or leave it grey for a flat look.
CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: standard-vs
      frag: standard-fs
      embeddedMacros: { CC_FORCE_FORWARD_SHADING: true }
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties: &props
        baseMap:          { value: grey, editor: { displayName: Base Map } }
        normalMap:        { value: normal, editor: { displayName: Normal (distortion) } }
        sceneColorMap:    { value: grey, editor: { displayName: Scene Color RT } }
        tillingOffset:    { value: [1.0, 1.0, 0.0, 0.0], editor: { displayName: Tilling Offset } }
        # HDR (các material Oozy dùng giá trị > 1) -> để dạng vec4 thay vì color picker
        tint:             { value: [0.0, 0.0, 0.0, 1.0] }
        refractionAmount: { value: 0.0, target: params.x, editor: { displayName: Refraction Amount, slide: true, range: [0, 1], step: 0.001 } }
        fresnelPower:     { value: 2.0, target: params.y, editor: { displayName: Power, slide: true, range: [0, 8], step: 0.001 } }
        fresnelStep:      { value: 0.35, target: params.z, editor: { displayName: Step, slide: true, range: [0, 1], step: 0.001 } }
        smoothness:       { value: 0.17, target: params.w, editor: { slide: true, range: [0, 1], step: 0.001 } }
        alpha:            { value: 1.0, target: params2.x, editor: { slide: true, range: [0, 1], step: 0.001 } }
        heightFadeEnd:    { value: 0.3, target: params2.y, editor: { displayName: Height Fade End } }
}%

CCProgram shared-ubos %{
  uniform Constants {
    vec4 tillingOffset;
    vec4 tint;
    vec4 params;   // x: refractionAmount, y: fresnelPower, z: fresnelStep, w: smoothness
    vec4 params2;  // x: alpha, y: heightFadeEnd
  };
}%

CCProgram macro-remapping %{
  #pragma define-meta USE_TWOSIDE
  #define CC_SURFACES_USE_TWO_SIDED USE_TWOSIDE
  #define CC_SURFACES_TRANSFER_CLIP_POS 1
}%

CCProgram surface-fragment %{
  uniform sampler2D baseMap;
  uniform sampler2D normalMap;
  uniform sampler2D sceneColorMap;

  float OozyFresnel()
  {
    vec3 N = normalize(FSInput_worldNormal);
    vec3 V = normalize(cc_cameraPos.xyz - FSInput_worldPos);
    return pow(max(1.0 - max(dot(N, V), 0.0), 0.0), max(params.y, 1e-4));
  }

  vec3 OozyGlow()
  {
    vec2 uvN = FSInput_texcoord * tillingOffset.xy + tillingOffset.zw + cc_time.x * 0.1;
    vec4 distortion = texture(normalMap, uvN) * params.x;

    vec2 screenUV = FSInput_clipPos.xy / FSInput_clipPos.w * 0.5 + 0.5;
    screenUV += distortion.xy;
    CC_HANDLE_RT_SAMPLE_FLIP(screenUV);
    vec3 sceneColor = SRGBToLinear(texture(sceneColorMap, screenUV).rgb);

    vec4 baseTex = texture(baseMap, FSInput_texcoord);
    baseTex.rgb = SRGBToLinear(baseTex.rgb);
    vec3 tinted = (baseTex * tint).rgb;

    float heightMask = smoothstep(0.0, max(params2.y, 1e-4), FSInput_worldPos.y);
    return sceneColor * tinted * heightMask;
  }

  #define CC_SURFACES_FRAGMENT_MODIFY_BASECOLOR_AND_TRANSPARENCY
  vec4 SurfacesFragmentModifyBaseColorAndTransparency()
  {
    float rim = step(params.z, OozyFresnel());
    return vec4(vec3(rim) + OozyGlow(), params2.x);
  }

  #define CC_SURFACES_FRAGMENT_MODIFY_EMISSIVE
  vec3 SurfacesFragmentModifyEmissive()
  {
    return OozyGlow();
  }

  #define CC_SURFACES_FRAGMENT_MODIFY_PBRPARAMS
  vec4 SurfacesFragmentModifyPBRParams()
  {
    return vec4(1.0, clamp(1.0 - params.w, 0.02, 1.0), 0.0, 0.5);
  }
}%

CCProgram standard-vs %{
  precision highp float;
  #include <macro-remapping>
  #include <surfaces/effect-macros/common-macros>
  #include <surfaces/includes/common-vs>
  #include <shared-ubos>
  #include <surfaces/includes/standard-vs>
  #include <shading-entries/main-functions/render-to-scene/vs>
}%

CCProgram standard-fs %{
  precision highp float;
  #include <macro-remapping>
  #include <surfaces/effect-macros/common-macros>
  #include <surfaces/includes/common-fs>
  #include <shared-ubos>
  #include <surface-fragment>
  #include <lighting-models/includes/standard>
  #include <surfaces/includes/standard-fs>
  #include <shading-entries/main-functions/render-to-scene/fs>
}%
